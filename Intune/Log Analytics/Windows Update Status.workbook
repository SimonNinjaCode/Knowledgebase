{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "\n## Windows Update Status\n---"
      },
      "name": "text - 2"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "WaaSUpdateStatus\r\n| project TimeGenerated, ComputerID, OSSecurityUpdateStatus\r\n| summarize dcount(ComputerID) by TimeGenerated, OSSecurityUpdateStatus",
        "size": 0,
        "title": "Security Updates Last 30 Days",
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "areachart",
        "graphSettings": {
          "type": 0,
          "topContent": {
            "columnMatch": "OSQualityUpdateStatus",
            "formatter": 1
          },
          "centerContent": {
            "columnMatch": "dcount_Computer",
            "formatter": 1,
            "numberFormat": {
              "unit": 17,
              "options": {
                "maximumSignificantDigits": 3,
                "maximumFractionDigits": 2
              }
            }
          }
        },
        "chartSettings": {
          "xAxis": "TimeGenerated",
          "yAxis": [
            "dcount_ComputerID"
          ],
          "showMetrics": false,
          "showLegend": true,
          "seriesLabelSettings": [
            {
              "seriesName": "Not Up-to-date",
              "color": "red"
            },
            {
              "seriesName": "Up-to-date",
              "color": "green"
            }
          ]
        }
      },
      "name": "Security Updates Last 30 Days"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "WaaSDeploymentStatus\r\n| where  UpdateCategory == \"Quality\" and UpdateClassification  == \"Security\"\r\n| where  isnotempty(UpdateReleasedDate)\r\n| where UpdateReleasedDate between (ago(30d) .. now())\r\n| where isnotempty(ComputerID)\r\n| extend  ReleaseName = strcat(OSVersion, ' - ', ReleaseName, ' - ', format_datetime(UpdateReleasedDate, 'yyyy-MM-dd'))\r\n| summarize arg_max(TimeGenerated, *) by ComputerID, TargetBuild\r\n| summarize  Total = count(),\r\n            Success = countif(DeploymentStatus == 'Update completed'),\r\n            Fails = countif(DeploymentStatus == 'Failed'),\r\n            Unknown = countif(DeploymentStatus == 'Unknown'),\r\n            ['In Progress'] = countif(DeploymentStatus == 'In progress'),\r\n            ['Progress stalled'] = countif(DeploymentStatus == 'Progress stalled')\r\n        by ReleaseName\r\n| extend  SuccessRate = (Success * 100 / Total)\r\n| order by ReleaseName",
        "size": 3,
        "title": "Security Update Status 0-30 Days",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "Security Update Status 0-30 Days"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "WaaSDeploymentStatus\r\n| where  UpdateCategory == \"Quality\" and UpdateClassification  == \"Security\"\r\n| where  isnotempty(UpdateReleasedDate)\r\n| where UpdateReleasedDate between (ago(60d) .. ago(31d))\r\n| where isnotempty(ComputerID)\r\n| extend  ReleaseName = strcat(OSVersion, ' - ', ReleaseName, ' - ', format_datetime(UpdateReleasedDate, 'yyyy-MM-dd'))\r\n| summarize arg_max(TimeGenerated, *) by ComputerID, TargetBuild\r\n| summarize  Total = count(),\r\n            Success = countif(DeploymentStatus == 'Update completed'),\r\n            Fails = countif(DeploymentStatus == 'Failed'),\r\n            Unknown = countif(DeploymentStatus == 'Unknown'),\r\n            ['In Progress'] = countif(DeploymentStatus == 'In progress'),\r\n            ['Progress stalled'] = countif(DeploymentStatus == 'Progress stalled')\r\n        by ReleaseName\r\n| extend  SuccessRate = (Success * 100 / Total)\r\n| order by ReleaseName",
        "size": 3,
        "title": "Security Update Status 31-60 Days",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "Security Update Status 31-60 Days"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "WaaSDeploymentStatus\r\n| where  UpdateCategory == \"Quality\" and UpdateClassification  == \"Security\"\r\n| where  isnotempty(UpdateReleasedDate)\r\n| where UpdateReleasedDate between (ago(90d) .. ago(61d))\r\n| where isnotempty(ComputerID)\r\n| extend  ReleaseName = strcat(OSVersion, ' - ', ReleaseName, ' - ', format_datetime(UpdateReleasedDate, 'yyyy-MM-dd'))\r\n| summarize arg_max(TimeGenerated, *) by ComputerID, TargetBuild\r\n| summarize  Total = count(),\r\n            Success = countif(DeploymentStatus == 'Update completed'),\r\n            Fails = countif(DeploymentStatus == 'Failed'),\r\n            Unknown = countif(DeploymentStatus == 'Unknown'),\r\n            ['In Progress'] = countif(DeploymentStatus == 'In progress'),\r\n            ['Progress stalled'] = countif(DeploymentStatus == 'Progress stalled')\r\n        by ReleaseName\r\n| extend  SuccessRate = (Success * 100 / Total)\r\n| order by ReleaseName",
        "size": 3,
        "title": "Security Update Status 61-90 Days",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "Security Update Status 61-90 Days"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
